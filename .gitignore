# QECTOR Decoder v3 -- .gitignore
# =================================

# --- Proprietary Rust Core (Never commit to public repo) ---
src/*
!src/lib.rs

# --- Build artifacts ---
/target/
/dist/
*.whl
*.tar.gz
*.pyd
*.so
*.dll
*.dylib

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
develop-eggs/
downloads/
eggs/
.installed.cfg
lib64/
parts/
sdist/
var/
wheels/
*.spec
pip-wheel-metadata/
share/python-wheels/
MANIFEST

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Rust ---
Cargo.lock.bak

# --- Generated lib artifacts (only OpenCL.def is tracked) ---
lib/OpenCL.lib
lib/OpenCL.exp

# --- Local build/dev directories ---
actions-runner/
artifacts/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Benchmark outputs (tracked selectively) ---
# benchmark_results/ is tracked intentionally for reproducibility evidence

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Temporary ---
*.tmp
*.bak
*.orig

# --- Session scratch / probe files (never committed) ---
_kimi_probe*.py
_kimi_probe*.txt
_probe*.py
_opencl_probe.py
_check_gitignore.ps1
_search_*.ps1
_search_*.txt
_pytest_*.log
_pytest_v*.log
test_full_v*.py
test_v0*.py

# kimi probe/fix helpers
_kimi_fix_probe.py
_fix_fixtures.py

# --- Secret environment & credentials ---
.env
licenses_issued.json

# --- Log files & scratch test outputs ---
*.log
*.txt
!SHA256SUMS.txt
!bp_osd_fns.txt
!mwpm_fns.txt
!tags.txt

# --- Temporary test environments & scratch scripts ---
.venv*/
repro_*.py
_fix_*.py
check_*.py
check_*.txt
clippy_*.txt
cargo_*.txt
errcheck_*.txt
maturin_*.txt
pip_show_*.txt
install_*.txt
test_*.txt
verify_*.log
wheel_build_*.log
wheel_verify.log

# --- Local-only docs (contain secret names / infra details, never push) ---
RELEASE_PROCEDURE.md

