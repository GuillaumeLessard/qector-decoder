class GNNPredecoder:
    NODE_FEAT_DIM: int = 10
    EDGE_FEAT_DIM: int = 8
    def __init__(
        self,
        node_feat_dim: Optional[int] = None,
        edge_feat_dim: Optional[int] = None,
        hidden_size: int = 16,
        n_layers: int = 2,
    ) -> None: ...
    @classmethod
    def new_standard(cls, hidden_size: int = 16, n_layers: int = 2) -> GNNPredecoder: ...
    def forward(self, graph: DetectorGraph) -> list[float]: ...
    def train(self, graphs: list[DetectorGraph], targets: list[list[float]], n_epochs: int) -> None: ...
    def predict_with_node_probs(self, graph: DetectorGraph) -> tuple[list[float], list[float]]: ...
    def save_weights(self, path: str) -> None: ...
    def load_weights(self, path: str) -> None: ...
    @property
    def learning_rate(self) -> float: ...
    @learning_rate.setter
    def learning_rate(self, lr: float) -> None: ...
    @property
    def l2_lambda(self) -> float: ...
    @l2_lambda.setter
    def l2_lambda(self, val: float) -> None: ...

class DetectorGraph:
    NODE_FEAT_DIM: int = 10
    EDGE_FEAT_DIM: int = 8
    def __init__(
        self,
        check_to_qubits: Any,
        syndrome: Any,
        check_positions: Any = None,
        check_types: Any = None,
        base_weights: Any = None,
        n_qubits: Optional[int] = None,
    ) -> None: ...
    def update_syndrome(self, syndrome: Any) -> None: ...
    @property
    def n_nodes(self) -> int: ...
    @property
    def n_edges(self) -> int: ...
    @property
    def node_features(self) -> Any: ...
    @property
    def edge_features(self) -> Any: ...
    @property
    def edge_qubit_id(self) -> Any: ...
    @property
    def edge_src(self) -> Any: ...
    @property
    def edge_dst(self) -> Any: ...

