class NeuralPredecoder:
    def __init__(
        self, n_input: int, n_output: int, n_hidden1: Optional[int] = None, n_hidden2: Optional[int] = None
    ) -> None: ...
    def train(self, syndromes: _U8, corrections: _U8, n_epochs: int, learning_rate: float = 0.01) -> None: ...
    def predict(self, syndrome: _U8) -> _U8: ...
    def decode(self, syndrome: _U8) -> _U8: ...
    @property
    def n_input(self) -> int: ...
    @property
