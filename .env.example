# QECTOR Decoder v3 - Environment Configuration Example
# Copy this file to .env and fill in the appropriate values.
# IMPORTANT: Never commit your actual .env file or private keys to source control!

# ---------------------------------------------------------------------------
# Licensing Cryptography (Ed25519)
# ---------------------------------------------------------------------------
# Base64-encoded PEM string of the Ed25519 private key used to sign commercial license tokens.
# Generate a keypair using: python generate_license_keys.py
QECTOR_LICENSE_PRIVATE_KEY_B64=

# ---------------------------------------------------------------------------
# Stripe API & Webhook Integration
# ---------------------------------------------------------------------------
# Stripe Live/Test API Secret Key (e.g. sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# Stripe Live/Test Publishable Key (e.g. pk_live_... or pk_test_...)
STRIPE_PUBLISHABLE_KEY=

# Stripe Webhook Signing Secret (e.g. whsec_...)
STRIPE_WEBHOOK_SECRET=

# Direct Stripe Commercial License Payment Link
STRIPE_PURCHASE_LINK=https://buy.stripe.com/7sY9AVdwlgoyfse9bYeUU00?locale=en&__embed_source=buy_btn_1TsoKxRsa9cg9l8A7ExMmc77

# License Key (v0.7.0)
# Set your QECTOR license key for Pro/Enterprise tier features.
# Resolution order: QECTOR_LICENSE_KEY, then QECTOR_LICENSE_FILE, then
# ~/.qector/license.key. Prefer the file form in deployments so the key does not
# appear in process listings or shell history.
QECTOR_LICENSE_KEY=
QECTOR_LICENSE_FILE=

# Stripe Metered Billing (Enterprise)
STRIPE_METERED_BILLING_KEY=

# QECTOR enforcement mode
# Set to "1" to enable hard tier enforcement (PermissionError on tier violations).
QECTOR_ENFORCE=0
