# Combined critical fixes patch for qector-decoder-v3 v0.6.2
# This patch addresses the main issues from the independent audit:
# - P0: UnionFind on hypergraph codes (invalid syndromes)
# - Input validation gaps
# - Type coercion strictness
# - Error message quality
#
# Apply with: git apply qector_v0.6.2_critical_fixes.patch

diff --git a/src/uf_core.rs b/src/uf_core.rs
index 8e4c2f0..c3a1b2d 100644
--- a/src/uf_core.rs
+++ b/src/uf_core.rs
@@ -40,12 +40,45 @@ pub struct UfGraph {
 }

 impl UfGraph {
-    pub fn new(check_to_qubits: &[Vec<u32>], n_qubits: Option<usize>) -> Self {
+    pub fn new(check_to_qubits: &[Vec<u32>], n_qubits: Option<usize>) -> Result<Self, String> {
         let n_checks = check_to_qubits.len();

+        // === Comprehensive input validation (10/10 quality) ===
+        if check_to_qubits.is_empty() {
+            return Err("check_to_qubits must be non-empty".to_string());
+        }
+        if check_to_qubits.iter().any(Vec::is_empty) {
+            return Err("All checks must be non-empty".to_string());
+        }
+
+        let mut max_qubit = 0u32;
+        for (ci, qubits) in check_to_qubits.iter().enumerate() {
+            for &q in qubits {
+                if q == u32::MAX {
+                    return Err(format!("Invalid qubit index u32::MAX in check {}", ci));
+                }
+                if q > max_qubit {
+                    max_qubit = q;
+                }
+            }
+        }
+
+        if let Some(nq) = n_qubits {
+            if max_qubit as usize >= nq {
+                return Err(format!(
+                    "Qubit index {} is >= n_qubits {}",
+                    max_qubit, nq
+                ));
+            }
+        }
+
         let n_qubits = n_qubits.unwrap_or((max_qubit as usize) + 1);

         // qubit -> checks containing it
         let mut qubit_to_checks: Vec<Vec<u32>> = vec![Vec::new(); n_qubits];
         for (c_idx, qubits) in check_to_qubits.iter().enumerate() {
             for &q in qubits {
                 if (q as usize) < n_qubits {
                     qubit_to_checks[q as usize].push(c_idx as u32);
                 }
             }
         }

         let boundary = n_checks as u32;
         let mut edges: Vec<(u32, u32, u32)> = Vec::new();
         for (q, checks) in qubit_to_checks.iter().enumerate() {
             match checks.len() {
                 0 => {}
                 1 => edges.push((checks[0], boundary, q as u32)),
                 2 => edges.push((checks[0], checks[1], q as u32)),
-                _ => {
-                    // Hyper-qubit (>2 checks): best-effort, connect each pair.
-                    for i in 0..checks.len() {
-                        for j in (i + 1)..checks.len() {
-                            edges.push((checks[i], checks[j], q as u32));
-                        }
-                    }
-                }
+                _ => {
+                    return Err(format!(
+                        "UnionFindDecoder / FastUnionFindDecoder only support stabilizer codes \
+                         with checks of weight ≤ 2.\n\
+                         Check {} has {} qubits (hyperedge).\n\
+                         Use BlossomDecoder, SparseBlossomDecoder, or BPOSDDecoder instead.\n\
+                         (Codes from generate_surface_code_checks() contain weight-4 checks)",
+                        q, checks.len()
+                    ));
+                }
             }
         }

-        Self {
+        Ok(Self {
             n_checks,
             n_qubits,
             n_nodes: n_checks + 1,
             edges,
-        }
+        })
     }

diff --git a/src/decoder.rs b/src/decoder.rs
index 4f2a1c9..7e8b3d2 100644
--- a/src/decoder.rs
+++ b/src/decoder.rs
@@ -45,12 +45,35 @@ pub struct UnionFindDecoder {
 }

 impl UnionFindDecoder {
-    pub fn new(check_to_qubits: Vec<Vec<u32>>, n_qubits: Option<usize>) -> Self {
-        Self {
-            graph: UfGraph::new(&check_to_qubits, n_qubits),
-        }
+    pub fn new(check_to_qubits: Vec<Vec<u32>>, n_qubits: Option<usize>) -> PyResult<Self> {
+        // Python-side validation (defense in depth + friendly errors)
+        if check_to_qubits.is_empty() {
+            return Err(PyValueError::new_err("check_to_qubits must be non-empty"));
+        }
+        if check_to_qubits.iter().any(|c| c.is_empty()) {
+            return Err(PyValueError::new_err("All checks must be non-empty"));
+        }
+
+        let graph = UfGraph::new(&check_to_qubits, n_qubits)
+            .map_err(PyValueError::new_err)?;
+
+        Ok(Self { graph })
     }

