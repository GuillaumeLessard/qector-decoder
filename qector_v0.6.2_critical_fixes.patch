-        Self {
-            graph: UfGraph::new(&check_to_qubits, n_qubits),
-        }
+    pub fn new(check_to_qubits: Vec<Vec<u32>>, n_qubits: Option<usize>) -> PyResult<Self> {
+        if check_to_qubits.is_empty() {
+            return Err(PyValueError::new_err("check_to_qubits must be non-empty"));
+        }
+        if check_to_qubits.iter().any(|c| c.is_empty()) {
+            return Err(PyValueError::new_err("All checks must be non-empty"));
+        }
+
+        let graph = UfGraph::new(&check_to_qubits, n_qubits)
+            .map_err(PyValueError::new_err)?;
+
+        Ok(Self { graph })
     }

diff --git a/python/qector_decoder_v3/__init__.py b/python/qector_decoder_v3/__init__.py
index 9c3e4f2..a1b5d7c 100644
--- a/python/qector_decoder_v3/__init__.py
+++ b/python/qector_decoder_v3/__init__.py
@@ -120,6 +120,20 @@ def recommend_decoder(check_to_qubits, n_qubits=None, prefer_speed=False):
     if any(len(c) > 2 for c in check_to_qubits):
         return "SparseBlossomDecoder"   # or BPOSDDecoder
     return "UnionFindDecoder"
+
+# Clean public API surface (reduce namespace leakage)
+__all__ = [
+    "UnionFindDecoder",
+    "FastUnionFindDecoder",
+    "BlossomDecoder",
+    "SparseBlossomDecoder",
+    "BPOSDDecoder",
+    "HybridDecoder",
+    "AutoDecoder",
+    "generate_surface_code_checks",
+    "recommend_decoder",
+]
